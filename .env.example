DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leetvibecode
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-change-me
OPENROUTER_API_KEY=
OPENROUTER_MOCK=1
TOKEN_CAP_PER_ATTEMPT=20000
DAILY_TOKEN_QUOTA=100000
GEN_THREADS=4
TEST_THREADS=2
CHALLENGES_DIR=../challenges
SANDBOX_DIR=/tmp/lvc-sandbox
# Dev: judge runs directly on the host, so SANDBOX_DIR and SANDBOX_HOST_DIR
# are the same real path. Prod (docker-compose.prod.yml): SANDBOX_DIR is
# fixed to /sandbox-tmp inside the judge container regardless of what's set
# here; SANDBOX_HOST_DIR must instead be the absolute path, ON THE HOST, that
# ./sandbox-tmp resolves to (see docs/deploy.md) -- get it wrong and every
# sandboxed run reports platform_error (runner.py's mount canary catches the
# mismatch loudly rather than silently mis-scoring a player).
SANDBOX_HOST_DIR=/tmp/lvc-sandbox

# --- docker-compose.prod.yml only; unused by dev ---
# Must match the password embedded in DATABASE_URL above once DATABASE_URL
# is repointed at the prod postgres service.
POSTGRES_PASSWORD=
# Caddy's site address -- a real domain (https://example.com auto-provisions
# TLS) or a bare port (:8080) for a plain-HTTP test. Empty here does NOT mean
# "no site": Caddy then misreads the Caddyfile's next line (rate_limit) as
# the site address and refuses to start -- reproduced; see docs/deploy.md.
SITE_ADDRESS=
